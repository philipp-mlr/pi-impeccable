{
  "name": "pi-impeccable",
  "version": "0.2.0",
  "description": "pi extension for Impeccable: ships the Impeccable skill, non-blocking live mode, and /impeccable command shortcuts",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "repository": "github:philipp-mlr/pi-impeccable",
  "files": [
    "extensions",
    "skills",
    "scripts",
    "README.md",
    "VENDOR.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": ["./extensions/impeccable.ts"],
    "skills": ["./skills"]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "drift": "node scripts/drift-check.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
